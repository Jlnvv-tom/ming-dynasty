[
  {
    "princeId": "taizu-s1",
    "life": "1355 — 1392",
    "fief": "懿文太子（未就藩）",
    "detail": "太祖嫡长子，洪武元年立为皇太子，多次受命监国，性仁厚。洪武二十五年视察陕西返京后病卒。太祖为之恸哭，改立其子朱允炆为皇太孙。靖难之役后其追尊帝号被削。",
    "sources": [{ "book": "明史", "chapter": "卷一百十五·兴宗孝康皇帝" }]
  },
  {
    "princeId": "taizu-s2",
    "life": "1356 — 1395",
    "fief": "秦（西安）",
    "detail": "洪武三年封秦王，就藩西安，镇守西北边陲。在藩多有过失，屡遭太祖斥责，卒谥「愍」。一说为宫人所毒。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "taizu-s3",
    "life": "1358 — 1398",
    "fief": "晋（太原）",
    "detail": "洪武三年封晋王，就藩太原，与燕王同镇北边，为明初北方屏藩。洪武三十一年卒，谥「恭」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "taizu-s4",
    "fief": "燕（北平）",
    "detail": "洪武三年封燕王，就藩北平，屡率兵出塞征蒙古。建文元年以「清君侧」起兵，四年后入南京夺位，是为成祖。",
    "sources": [{ "book": "明史", "chapter": "卷五·成祖本纪" }]
  },
  {
    "princeId": "taizu-s5",
    "life": "1361 — 1425",
    "fief": "吴 → 周（开封）",
    "detail": "初封吴王，洪武十一年改封周王，十四年就藩开封。永乐朝曾以谋逆之嫌削其护卫。好医药，编《救荒本草》，为明代重要的植物与救荒文献。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "taizu-s6",
    "fief": "楚（武昌）",
    "detail": "洪武三年封楚王，就藩武昌，屡率兵平定南方蛮乱，为南方重镇藩屏，谥「昭」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "taizu-s7",
    "fief": "齐（青州）",
    "detail": "洪武三年封齐王，就藩青州。性凶暴，建文朝被废为庶人，永乐初复封后又以罪削爵，废锢以终。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "taizu-s8",
    "fief": "潭（长沙）",
    "detail": "洪武三年封潭王，就藩长沙。洪武二十三年因岳父于显卷入胡惟庸案而惊惧，与妃自焚而死，无子国除。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "taizu-s9",
    "fief": "赵（未就藩）",
    "detail": "洪武二年生，洪武三年受封赵王，未及就藩即夭折。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "taizu-s10",
    "fief": "鲁（兖州）",
    "detail": "洪武三年封鲁王，十八年就藩兖州。好文礼士、善诗歌，然饵金石药求长生，毒发伤目而卒，太祖恶其行，谥「荒」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "taizu-s11",
    "fief": "蜀（成都）",
    "detail": "洪武十一年封蜀王，二十三年就藩成都。好学近儒，礼聘方孝孺为世子师，蜀中称为「贤王」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十七·诸王传二" }]
  },
  {
    "princeId": "taizu-s12",
    "fief": "湘（荆州）",
    "detail": "洪武十一年封湘王，就藩荆州。喜读书、好道术。建文削藩时被诬谋反，无以自明，阖宫自焚而死。",
    "sources": [{ "book": "明史", "chapter": "卷一百十七·诸王传二" }]
  },
  {
    "princeId": "taizu-s13",
    "fief": "豫 → 代（大同）",
    "detail": "初封豫王，后改封代王，就藩大同，为北边屏藩。性暴戾，屡为不法，正统十一年卒。",
    "sources": [{ "book": "明史", "chapter": "卷一百十七·诸王传二" }]
  },
  {
    "princeId": "taizu-s14",
    "fief": "汉 → 肃（甘州、后移兰州）",
    "detail": "初封汉王，后改封肃王，初就藩甘州，后移兰州，控扼河西走廊。",
    "sources": [{ "book": "明史", "chapter": "卷一百十七·诸王传二" }]
  },
  {
    "princeId": "taizu-s15",
    "fief": "卫 → 辽（广宁，后移荆州）",
    "detail": "初封卫王，后改封辽王，就藩广宁以镇辽东。靖难后被改封荆州。",
    "sources": [{ "book": "明史", "chapter": "卷一百十七·诸王传二" }]
  },
  {
    "princeId": "taizu-s16",
    "fief": "庆（宁夏）",
    "detail": "洪武二十四年封庆王，就藩宁夏，掌北边屯戍，为九边藩屏之一。",
    "sources": [{ "book": "明史", "chapter": "卷一百十七·诸王传二" }]
  },
  {
    "princeId": "taizu-s17",
    "fief": "宁（大宁，后移南昌）",
    "detail": "洪武二十四年封宁王，就藩大宁，带甲八万、战车六千，为边藩之最。靖难中被燕王并其军，后改封南昌。好文，著《太和正音谱》，为戏曲音律的重要文献。",
    "sources": [{ "book": "明史", "chapter": "卷一百十七·诸王传二" }]
  },
  {
    "princeId": "taizu-s18",
    "fief": "岷（岷州，后移云南）",
    "detail": "洪武二十四年封岷王，初就藩岷州，后改云南，曾为西平侯沐晟所劾而削护卫。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "taizu-s19",
    "fief": "谷（宣府，后移长沙）",
    "detail": "洪武二十四年封谷王，就藩宣府。靖难之役中开门迎燕军入金川门，后改封长沙，永乐朝以谋反被废为庶人。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "taizu-s20",
    "fief": "韩（开原，后移平凉）",
    "detail": "洪武二十四年封韩王，未就藩而卒，谥「宪」，其后嗣就藩平凉。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "taizu-s21",
    "fief": "沈（潞州）",
    "detail": "洪武二十四年封沈王，永乐六年就藩潞州。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "taizu-s22",
    "fief": "安（平凉）",
    "detail": "洪武二十四年封安王，永乐六年就藩平凉，无子国除。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "taizu-s23",
    "fief": "唐（南阳）",
    "detail": "洪武二十四年封唐王，永乐六年就藩南阳。其九世孙朱聿键、朱聿鐭即南明隆武、绍武二帝。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "taizu-s24",
    "life": "1388 — 1414",
    "fief": "郢（安陆）",
    "detail": "洪武二十四年封郢王，永乐六年就藩安陆，永乐十二年卒，无子国除。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "taizu-s25",
    "life": "1388 — 1414",
    "fief": "伊（洛阳）",
    "detail": "洪武二十四年封伊王，永乐六年就藩洛阳。多行不法，永乐十二年卒，谥「厉」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "taizu-s26",
    "life": "1394 — 1394",
    "fief": "未封王",
    "detail": "太祖第二十六子，洪武二十七年生，未逾月而夭，未及封爵。",
    "sources": [{ "book": "明史", "chapter": "卷一百十六·诸王传一" }]
  },
  {
    "princeId": "huidi-s1",
    "fief": "和简太子",
    "detail": "建文元年立为皇太子。南京城破时年方七岁，与父一同不知所终。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "huidi-s2",
    "fief": "润怀王",
    "detail": "建文三年生。南京陷落后被幽禁中都凤阳五十余年，称「建庶人」。天顺元年英宗释之，未几卒。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "chengzu-s1",
    "fief": "太子 → 即位",
    "detail": "成祖长子，永乐二年立为皇太子，多受命监国。永乐二十二年即位，是为仁宗。",
    "sources": [{ "book": "明史", "chapter": "卷八·仁宗本纪" }]
  },
  {
    "princeId": "chengzu-s2",
    "life": "1380 — 1426",
    "fief": "汉（乐安州）",
    "detail": "成祖次子，靖难之役中屡立战功，恃功骄纵。永乐十五年就藩乐安州，宣德元年举兵反，宣宗亲征俘之，废为庶人，后以铜缸覆之、积炭炙死。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "chengzu-s3",
    "fief": "赵（彰德）",
    "detail": "成祖第三子，永乐二年封赵王，就藩彰德。永乐末曾涉谋逆之议，宣德朝又被告发谋反，得宣宗宽宥，以善终。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "chengzu-s4",
    "fief": "未封王",
    "detail": "成祖第四子，幼卒，未及封爵。",
    "sources": [{ "book": "明史", "chapter": "卷一百十八·诸王传三" }]
  },
  {
    "princeId": "renzong-s1",
    "fief": "太子 → 即位",
    "detail": "仁宗长子，永乐九年立为皇太孙，洪熙元年即位，是为宣宗。",
    "sources": [{ "book": "明史", "chapter": "卷九·宣宗本纪" }]
  },
  {
    "princeId": "renzong-s2",
    "fief": "郑（凤翔，后移怀庆）",
    "detail": "仁宗次子，洪熙元年封郑王，宣德四年就藩凤翔，正统八年移藩怀庆。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "renzong-s3",
    "fief": "越（未就藩）",
    "detail": "仁宗第三子，洪熙元年封越王，未就藩而卒，谥「靖」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "renzong-s4",
    "fief": "蕲（未就藩）",
    "detail": "仁宗第四子，早卒，追封蕲王，谥「献」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "renzong-s5",
    "fief": "襄（长沙，后移襄阳）",
    "detail": "仁宗第五子，宣德四年就藩长沙，正统元年移襄阳。历事六朝，正统、景泰、天顺间多次入朝觐见，号为「贤王」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "renzong-s6",
    "fief": "荆（建昌，后移蕲州）",
    "detail": "仁宗第六子，宣德四年就藩建昌，正统十年移蕲州。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "renzong-s7",
    "fief": "淮（韶州，后移饶州）",
    "detail": "仁宗第七子，宣德四年就藩韶州，正统元年移饶州。其九世孙朱常清即南明「东武」监国。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "renzong-s8",
    "fief": "滕（未就藩）",
    "detail": "仁宗第八子，封滕王，未就藩而卒。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "renzong-s9",
    "fief": "梁（安陆）",
    "detail": "仁宗第九子，永乐二十二年封梁王，宣德四年就藩安陆。其墓 2001 年发掘，出土金玉器物数千件，为明代亲王墓的重要发现。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "renzong-s10",
    "fief": "卫（怀庆）",
    "detail": "仁宗第十子，封卫王，就藩怀庆。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "xuanzong-s1",
    "fief": "太子 → 即位",
    "detail": "宣宗长子，宣德三年立为皇太子，宣德十年即位，是为英宗。",
    "sources": [{ "book": "明史", "chapter": "卷十·英宗前纪" }]
  },
  {
    "princeId": "xuanzong-s2",
    "fief": "郕王 → 即位",
    "detail": "宣宗次子，宣德十年封郕王。土木之变后受命监国、旋即帝位，是为代宗。",
    "sources": [{ "book": "明史", "chapter": "卷十一·景帝本纪" }]
  },
  {
    "princeId": "yingzong-s1",
    "fief": "太子 → 即位",
    "detail": "英宗长子，正统十四年立为皇太子，景泰三年被代宗废为沂王，天顺元年复立，天顺八年即位，是为宪宗。",
    "sources": [{ "book": "明史", "chapter": "卷十三·宪宗一" }]
  },
  {
    "princeId": "yingzong-s2",
    "fief": "德（济南）",
    "detail": "英宗次子，天顺元年封德王，成化三年就藩济南。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "yingzong-s3",
    "fief": "未封",
    "detail": "英宗第三子，二岁夭折，未及封爵。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "yingzong-s4",
    "fief": "许（未就藩）",
    "detail": "英宗第四子，早卒，追封许王，谥「悼」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "yingzong-s5",
    "fief": "秀（汝宁）",
    "detail": "英宗第五子，成化六年就藩汝宁。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "yingzong-s6",
    "fief": "崇（汝宁）",
    "detail": "英宗第六子，成化十年就藩汝宁。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "yingzong-s7",
    "fief": "吉（长沙）",
    "detail": "英宗第七子，成化十三年就藩长沙。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "yingzong-s8",
    "fief": "忻（未就藩）",
    "detail": "英宗第八子，未就藩而卒，谥「穆」。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "yingzong-s9",
    "fief": "徽（钧州）",
    "detail": "英宗第九子，成化十七年就藩钧州。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "daizong-s3",
    "fief": "郕王世子 → 皇太子",
    "detail": "代宗独子。景泰三年立为皇太子，次年夭折，谥「怀献」。其死使代宗无嗣，为夺门之变与英宗复辟埋下伏笔。",
    "sources": [{ "book": "明史", "chapter": "卷十一·景帝本纪" }]
  },
  {
    "princeId": "xianzong-s1",
    "fief": "未封",
    "detail": "宪宗长子，未及命名而夭。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "xianzong-s2",
    "fief": "悼恭太子",
    "detail": "宪宗次子，成化七年立为皇太子，次年夭折。",
    "sources": [{ "book": "明史", "chapter": "卷一百十九·诸王传四" }]
  },
  {
    "princeId": "xianzong-s3",
    "fief": "太子 → 即位",
    "detail": "宪宗第三子，成化十一年立为皇太子，成化二十三年即位，是为孝宗。",
    "sources": [{ "book": "明史", "chapter": "卷十五·孝宗本纪" }]
